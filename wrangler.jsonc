{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ⚠️ Must exactly match your Cloudflare Pages project name (the slug shown
  // in the Workers & Pages dashboard URL / project list) — NOT the repo name.
  "name": "gb-driver",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-06-21",
  // The fuel-price-history KV namespace has been replaced by D1 (see
  // workers/fuel-cron/ for the cron Worker that writes to it). This Pages
  // project only needs read access — same binding name "DB" as the worker,
  // and the SAME database_id as workers/fuel-cron/wrangler.jsonc.
  // and the SAME database_id as workers/fuel-cron/wrangler.jsonc.
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gbdriver-fuel-history",
      "database_id": "bbcfde70-4937-4bbf-91e1-3cf2282e15dc"
    }
  ]
}


